# Local testing: headless Codex CLI uses your existing ChatGPT login.
# Run `codex login` once. Select Sol/Astra above the design chat composer.
# CODEX_MODEL sets the initial default; the saved page selection takes precedence.
DESIGN_BACKEND=codex-cli
CODEX_MODEL=gpt-6.1-sol
# CODEX_BINARY=codex
# Voice stays disabled for testing. Set true to restore audio controls/endpoints.
VOICE_ENABLED=false
# Set DESIGN_BACKEND=gateway to use a paid Gateway design model instead.
# One optional Vercel AI Gateway key for Gateway design and enabled audio.
# Alternatively enter the key in the app's Connections panel.
AI_GATEWAY_API_KEY=
# Optional model/voice overrides. Leave unset to use editable UI settings.
# AI_GATEWAY_MODEL=anthropic/claude-sonnet-5.5
# AI_GATEWAY_TRANSCRIPTION_MODEL=spacexai/grok-stt
# AI_GATEWAY_SPEECH_MODEL=google/gemini-3.8-flash-lite-tts
# AI_GATEWAY_SPEECH_VOICE=Kore
# The server only listens on loopback. Defaults to port 5173.
PORT=5173
